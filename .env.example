# Salin file ini menjadi .env.local lalu isi nilai sebenarnya.
# JANGAN commit file .env.local (sudah di-ignore lewat .gitignore).

# Connection string Postgres. Untuk Postgres lokal via docker-compose
# di root proyek (service "db", database "kopikita"):
DATABASE_URL=postgresql://kopikita:kopikita123@localhost:5432/kopikita

# Base URL untuk apiFetch (lib/api.ts). Kosongkan (default) supaya
# memanggil path relatif "/api/..." di origin yang sama -- backend
# Express (server/) jalan sebagai bagian dari proses Next.js ini, bukan
# server terpisah. Isi dengan URL lengkap hanya kalau API-nya sengaja
# dipisah lagi ke domain/port lain.
NEXT_PUBLIC_API_URL=
