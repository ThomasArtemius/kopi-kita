# Salin file ini menjadi .env lalu isi nilai sebenarnya.
# JANGAN commit file .env (sudah di-ignore lewat .gitignore).

# Connection string Postgres. Untuk Postgres lokal via docker-compose
# di root proyek (service "db", database "kopikita"):
DATABASE_URL=postgresql://kopikita:kopikita123@localhost:5432/kopikita

# Port server Express
PORT=4000

# Origin frontend yang diizinkan mengakses API ini (CORS)
CORS_ORIGIN=http://localhost:3000
